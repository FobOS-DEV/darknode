{
  "name": "vpn-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:container": "npm run start",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "healthcheck": "node dist/healthcheck.js",
    "test": "npm run build && node --test test/**/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:resolve": "prisma migrate resolve",
    "seed:test": "node scripts/seed-test-data.js",
    "import:xray": "node scripts/import-xray-clients.js",
    "reminders:send": "node dist/reminders.js",
    "expiry:sweep": "node dist/expirySweep.js",
    "traffic:snapshot": "node dist/trafficSnapshots.js",
    "backup:sqlite": "node scripts/backup-sqlite.js",
    "restore:sqlite": "node scripts/restore-sqlite.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@prisma/client": "^6.5.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "nodemailer": "^8.0.7",
    "pino": "^9.6.0",
    "protobufjs": "^8.0.0",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.5",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
