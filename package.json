{
  "name": "vpn-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:container": "npm run prisma:deploy && npm run start",
    "build": "tsc -p tsconfig.json",
    "healthcheck": "node dist/healthcheck.js",
    "test": "npm run prisma:generate && npm run build && node --test test/**/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:test": "node scripts/seed-test-data.js"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
