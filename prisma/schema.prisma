generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  telegramId     String          @unique
  username       String?
  firstName      String?
  lastName       String?
  fullName       String
  isAdmin        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  vpnClient      VpnClient?
  subscription   Subscription?
  accessRequests AccessRequest[]
  auditLogs      AuditLog[]      @relation("actorAuditLogs")
  targetedBy     AuditLog[]      @relation("targetAuditLogs")
  trafficSnapshots TrafficSnapshot[]
}

model Inbound {
  id              Int       @id @default(autoincrement())
  label           String
  inboundTag      String    @unique
  host            String
  port            Int
  sni             String
  publicKey       String
  shortId         String
  flow            String
  fingerprint     String    @default("chrome")
  network         String    @default("tcp")
  security        String    @default("reality")
  xrayApiAddress  String?
  status          String    @default("ACTIVE")
  priority        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deprecatedAt    DateTime?
  vpnClients      VpnClient[]

  @@index([status, priority])
}

model VpnClient {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  displayName String
  emailLabel  String
  uuid        String   @unique
  vlessUrl    String
  server      String
  port        Int
  publicKey   String
  shortId     String
  sni         String
  flow        String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  updatedAt   DateTime @updatedAt
  inboundId   Int?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inbound     Inbound? @relation(fields: [inboundId], references: [id], onDelete: SetNull)
  trafficSnapshots TrafficSnapshot[]

  @@index([inboundId])
}

model Subscription {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  token          String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  action       String
  actorUserId  Int
  targetUserId Int?
  payloadJson  String?
  createdAt    DateTime @default(now())
  actorUser    User     @relation("actorAuditLogs", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetUser   User?    @relation("targetAuditLogs", fields: [targetUserId], references: [id], onDelete: SetNull)
}

model AccessRequest {
  id          Int      @id @default(autoincrement())
  userId       Int
  status      String   @default("PENDING")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model TrafficSnapshot {
  id            Int      @id @default(autoincrement())
  userId        Int
  vpnClientId   Int
  uplinkBytes   Int
  downlinkBytes Int
  totalBytes    Int
  capturedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpnClient     VpnClient @relation(fields: [vpnClientId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
  @@index([vpnClientId, capturedAt])
  @@index([capturedAt])
}
