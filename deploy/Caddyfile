{
	email {$SUB_TLS_EMAIL:admin@example.com}
}

{$SUB_DOMAIN}:9443 {
	encode zstd gzip

	@backend path /sub/* /healthz /api/*
	handle @backend {
		reverse_proxy bot:3001
	}

	handle {
		root * /srv/site
		try_files {path} {path}/ /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

# Plain HTTP listener for ACME HTTP-01 challenge only; everything else
# redirects to the HTTPS port above.
http://{$SUB_DOMAIN} {
	redir https://{host}:9443{uri}
}
