{
	email {$SUB_TLS_EMAIL:admin@example.com}
}

# Primary site domain — new subscriptions, web sign-up, app dashboard
{$SITE_DOMAIN}:9443 {
	encode zstd gzip

	@backend path /sub/* /healthz /api/*
	handle @backend {
		reverse_proxy bot:3001
	}

	handle {
		root * /srv/site
		try_files {path} {path}/ /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

www.{$SITE_DOMAIN}:9443 {
	redir https://{$SITE_DOMAIN}:9443{uri}
}

# Legacy subscription host — existing users' Hiddify/v2rayN clients still
# pull from https://vpn.hedgenode.ru:9443/sub/<token>, keep it serving.
{$SUB_DOMAIN}:9443 {
	encode zstd gzip

	@subscriptions path /sub/* /healthz
	handle @subscriptions {
		reverse_proxy bot:3001
	}

	handle {
		respond "not found" 404
	}

	log {
		output stdout
		format console
	}
}

# Plain HTTP listeners for ACME HTTP-01 challenges + redirect to HTTPS port.
http://{$SITE_DOMAIN}, http://www.{$SITE_DOMAIN}, http://{$SUB_DOMAIN} {
	redir https://{host}:9443{uri}
}
